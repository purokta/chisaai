<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <!-- ============ HOME ============ -->
        <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="18dp">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-light" android:text="Chisa" android:textColor="?attr/colorOnSurface" android:textSize="38sp" />
                        <TextView android:id="@+id/subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageButton android:id="@+id/power" android:layout_width="52dp" android:layout_height="52dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_circle_primary" android:contentDescription="Mulai atau hentikan bot" android:src="@drawable/ic_power" app:tint="?attr/colorOnPrimaryContainer" />
                </RelativeLayout>

                <com.google.android.material.card.MaterialCardView android:id="@+id/statusCard" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardCornerRadius="30dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="20dp">
                        <FrameLayout android:layout_width="52dp" android:layout_height="52dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_circle_primary">
                            <ImageView android:id="@+id/statusIcon" android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_off" app:tint="?attr/colorOnPrimaryContainer" />
                        </FrameLayout>
                        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout android:id="@+id/apkBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

                <com.google.android.material.card.MaterialCardView android:id="@+id/codeCard" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:visibility="gone" app:cardBackgroundColor="?attr/colorTertiaryContainer" app:cardCornerRadius="30dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
                        <TextView android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="monospace" android:letterSpacing="0.12" android:textColor="?attr/colorOnTertiaryContainer" android:textSize="32sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Ketuk kode untuk menyalin\nWhatsApp › Perangkat tertaut › Tautkan dengan nomor telepon" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginBottom="10dp" app:cardBackgroundColor="?attr/colorSurfaceContainerHighest" app:cardCornerRadius="30dp">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                        <TextureView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="match_parent" />
                        <ImageView android:id="@+id/bannerImg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton android:id="@+id/toggle" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="12dp" android:textSize="16sp" app:cornerRadius="29dp" />

                <LinearLayout android:id="@+id/infoList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

                <com.google.android.material.card.MaterialCardView android:id="@+id/miniLogCard" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="#14161C" app:cardCornerRadius="26dp">
                    <TextView android:id="@+id/miniLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:fontFamily="monospace" android:maxLines="8" android:textColor="#C9D1D9" android:textSize="11sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <!-- ============ TERMINAL ============ -->
        <LinearLayout android:id="@+id/pageTerm" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:fontFamily="sans-serif-light" android:text="Terminal" android:textColor="?attr/colorOnSurface" android:textSize="34sp" />
                <ImageButton android:id="@+id/openLog" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:background="@drawable/bg_circle" android:contentDescription="Log lengkap, simpan, bagikan" android:src="@drawable/ic_log" app:tint="?attr/colorOnSecondaryContainer" />
            </RelativeLayout>
            <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/termMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:checkedButton="@+id/modeLog" app:selectionRequired="true" app:singleSelection="true">
                <com.google.android.material.button.MaterialButton android:id="@+id/modeLog" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Log bot" />
                <com.google.android.material.button.MaterialButton android:id="@+id/modeShell" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Shell" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" app:cardBackgroundColor="#14161C" app:cardCornerRadius="28dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                    <ScrollView android:id="@+id/termScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp">
                        <TextView android:id="@+id/termText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="#C9D1D9" android:textIsSelectable="true" android:textSize="11sp" />
                    </ScrollView>
                    <ScrollView android:id="@+id/shellScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp" android:visibility="gone">
                        <TextView android:id="@+id/shellText" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="#C9D1D9" android:textIsSelectable="true" android:textSize="11sp" />
                    </ScrollView>
                    <LinearLayout android:id="@+id/shellBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#1C1F27" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="4dp" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:text="$" android:textColor="#7EE787" android:textSize="14sp" />
                        <EditText android:id="@+id/shellIn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@null" android:fontFamily="monospace" android:hint="ketik perintah (ls, cat, tail…)" android:imeOptions="actionSend" android:inputType="textNoSuggestions" android:paddingStart="8dp" android:singleLine="true" android:textColor="#C9D1D9" android:textColorHint="#6E7681" android:textSize="13sp" />
                        <ImageButton android:id="@+id/shellSend" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Jalankan" android:src="@drawable/ic_send" app:tint="#7EE787" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ============ PENGATURAN ============ -->
        <ScrollView android:id="@+id/pageSet" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="18dp" android:fontFamily="sans-serif-light" android:text="Pengaturan" android:textColor="?attr/colorOnSurface" android:textSize="34sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:text="Tampilan" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Warna" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/palRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Mode" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/modeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:selectionRequired="true" app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeSys" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sistem" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeLight" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Terang" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/modeDark" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gelap" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Ikon aplikasi" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/iconRow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <com.google.android.material.button.MaterialButton android:id="@+id/iconCustom" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Ikon dari gambar sendiri (pintasan)" app:cornerRadius="27dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Ikon custom dipasang sebagai pintasan di layar utama, karena Android tidak mengizinkan mengganti ikon aplikasi dengan gambar bebas." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Banner" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Ganti 4 banner bergerak. Dipakai di aplikasi dan di menu bot (WhatsApp &amp; Telegram), berganti tiap menu dibuka. Bisa GIF, MP4 (maks 10 detik), atau gambar. Slot kosong memakai banner bawaan." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <LinearLayout android:id="@+id/slotList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Banner dari YouTube (di aplikasi)" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Video diunduh oleh bot (360p, bersuara) lalu diputar di Home — jadi bot harus menyala saat menerapkan. Tidak terkena larangan embed YouTube." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Link video YouTube">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ytLink" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Mulai di detik ke-">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ytStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Durasi (detik, 0 = penuh)">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/ytDur" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView android:id="@+id/ytStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/ytEnable" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Pakai YouTube sebagai banner di Home" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/ytSound" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Suara aktif (diputar bersama banner)" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ytApply" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Terapkan banner YouTube" app:cornerRadius="27dp" />
            
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Bot" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Nomor WhatsApp bot (628…)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/botNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Nomor owner (kosong = sama dengan bot)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ownerNum" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Token Telegram (opsional)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/tgToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="ID Telegram owner (opsional)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/tgOwner" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/saveSet" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:text="Simpan" app:cornerRadius="27dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Perubahan nomor/token berlaku saat bot dimulai ulang." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Sumber script bot (GitHub)" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <TextView android:id="@+id/ghInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Repo (pemilik/nama atau link GitHub)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ghRepo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Branch (mis. main)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ghBranch" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Token GitHub (hanya untuk repo privat)">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ghToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/ghAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Update otomatis saat bot dimulai" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ghUpdate" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Cek &amp; pasang update sekarang" app:cornerRadius="27dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/ghRestore" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kembali ke script bawaan APK" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Hanya script bot yang diperbarui. Dependensi tetap dari APK; kalau repo butuh dependensi baru, build APK baru. Login &amp; data aman." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Aplikasi" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoBoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nyalakan bot otomatis setelah HP restart" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/autoClear" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="Hapus log otomatis saat bot dimulai" />
                <com.google.android.material.button.MaterialButton android:id="@+id/apkCheck" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Cek versi APK baru" app:cornerRadius="27dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Alat Termux (ffmpeg &amp; yt-dlp)" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorOnSurface" />
                <TextView android:id="@+id/termuxStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Memeriksa…" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
                <com.google.android.material.button.MaterialButton android:id="@+id/termuxStart" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Nyalakan alat Termux" app:cornerRadius="27dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/termuxHelp" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cara pasang (sekali saja)" />
                <com.google.android.material.button.MaterialButton android:id="@+id/resetSession" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="Reset sesi WhatsApp (pairing ulang)" app:cornerRadius="27dp" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ TENTANG ============ -->
        <ScrollView android:id="@+id/pageAbout" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="18dp" android:fontFamily="sans-serif-light" android:text="Tentang" android:textColor="?attr/colorOnSurface" android:textSize="34sp" />

                <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardCornerRadius="30dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="22dp">
                        <com.google.android.material.card.MaterialCardView android:id="@+id/ownerPpCard" android:layout_width="132dp" android:layout_height="132dp" app:cardCornerRadius="66dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">
                            <ImageView android:id="@+id/ownerPp" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Foto owner bot" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView android:id="@+id/ownerNameShow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/ownerBioShow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                            <com.google.android.material.button.MaterialButton android:id="@+id/ownerPpPick" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Ganti foto" app:cornerRadius="26dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/ownerPpReset" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="Bawaan" app:cornerRadius="26dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Profil owner bot" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Nama owner">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ownerName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.FilledBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxCornerRadiusTopStart="22dp" app:boxCornerRadiusTopEnd="22dp" app:boxCornerRadiusBottomStart="22dp" app:boxCornerRadiusBottomEnd="22dp" app:boxStrokeWidth="0dp" app:boxStrokeWidthFocused="0dp" app:boxBackgroundColor="?attr/colorSurfaceContainerLow" android:hint="Bio singkat">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/ownerBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/ownerSave" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="Simpan profil" app:cornerRadius="27dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Foto dan nama ini dipakai di aplikasi dan di perintah owner bot. Berlaku setelah bot dimulai ulang." android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="2dp" android:text="Pengembang" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorPrimary" />
                <com.google.android.material.card.MaterialCardView style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardBackgroundColor="?attr/colorSurfaceContainerLow" app:cardCornerRadius="26dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHISA-AI" android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/aboutVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Bot WhatsApp &amp; Telegram yang berjalan langsung di dalam aplikasi ini. Dibuat oleh shipur." android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/linkGithub" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:text="Kode di GitHub" app:cornerRadius="27dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/linkTiktok" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:text="TikTok @dzzhipur" app:cornerRadius="27dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        app:elevation="0dp"
        app:menu="@menu/nav" />
</LinearLayout>
